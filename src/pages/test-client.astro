---
import Layout from "@/layouts/Layout.astro";
import { TestButton } from "@/components/TestButton";
---

<Layout title="Test Client | Fiszki">
  <div class="container mx-auto py-16 px-4">
    <div class="max-w-md mx-auto">
      <h1 class="text-3xl font-bold text-center mb-8">Test Client Component</h1>

      <div class="space-y-4">
        <p>This page tests if client:load directive is working properly with event handlers.</p>

        <TestButton
          client:load
          onClick={() => {
            // Removed console.log to fix ESLint no-console warning
            if (typeof window !== "undefined") {
              // eslint-disable-next-line no-undef
              window.alert("Button clicked successfully!");
            }
          }}
        />
      </div>
    </div>
  </div>
</Layout>

<script>
  // Removed console.log to fix ESLint no-console warning // Script loaded successfully
</script>
