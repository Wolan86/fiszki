---
import Layout from "@/layouts/Layout.astro";
import { LoginForm } from "@/components/auth/LoginForm";

// Sprawdzenie czy użytkownik jest już zalogowany
const user = Astro.locals.user;
if (user) {
  return Astro.redirect("/kreator");
}

// Sprawdzenie czy użytkownik został przekierowany po rejestracji
const registered = Astro.url.searchParams.get("registered") === "true";
const confirmation = Astro.url.searchParams.get("confirmation") === "true";
const confirmed = Astro.url.searchParams.get("confirmed") === "true";
const error = Astro.url.searchParams.get("error");
const message = Astro.url.searchParams.get("message");

// Ustawienie prerender na false, aby strona była renderowana na serwerze
export const prerender = false;
---

<Layout title="Logowanie | Fiszki">
  <div class="container mx-auto py-16 px-4">
    <div class="max-w-md mx-auto">
      <h1 class="text-3xl font-bold text-center mb-8">Logowanie</h1>

      {
        registered && (
          <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">Rejestracja zakończona pomyślnie! Możesz się teraz zalogować.</span>
          </div>
        )
      }

      {
        confirmation && (
          <div class="bg-blue-100 border border-blue-400 text-blue-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">
              Sprawdź swoją skrzynkę pocztową i potwierdź adres email, aby aktywować konto. Po potwierdzeniu będziesz
              mógł się zalogować.
            </span>
          </div>
        )
      }

      {
        confirmed && (
          <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">Adres email został pomyślnie potwierdzony! Możesz się teraz zalogować.</span>
          </div>
        )
      }

      {
        error && message && (
          <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{decodeURIComponent(message)}</span>
          </div>
        )
      }

      <LoginForm client:load isLoading={false} />
    </div>
  </div>
</Layout>
